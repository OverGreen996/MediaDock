{
  "manifest_version": 3,
  "name": "MediaDock 媒體下載",
  "version": "0.4.1",
  "description": "多平台影片與媒體來源偵測，選畫質與儲存位置，下載後核對來源及完整影音驗證。",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen", "webRequest", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtubei.googleapis.com/*", "https://*.googlevideo.com/*", "https://*.bilibili.com/*", "https://*.bilivideo.com/*", "https://*.bilivideo.cn/*", "https://*.hdslb.com/*", "https://*.akamaized.net/*"],
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["youtube-button.js"], "run_at": "document_idle"}],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "MediaDock 媒體下載"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_page": "setup.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
