{
  "manifest_version": 3,
  "name": "MediaDock YouTube 下載",
  "version": "0.5.0",
  "description": "只下載 YouTube 一般影片與 Shorts；選畫質、完整影音驗證後選擇儲存位置。",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://*.googlevideo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaDock YouTube 下載"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "setup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "0.5.0（YouTube 開發測試版）"
}
